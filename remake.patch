diff -ruN a/soh/soh/Enhancements/Remake/RemakeFeatures.cpp b/soh/soh/Enhancements/Remake/RemakeFeatures.cpp
--- a/soh/soh/Enhancements/Remake/RemakeFeatures.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/soh/soh/Enhancements/Remake/RemakeFeatures.cpp	2026-11-15 17:44:41.721711892 +0000
@@ -0,0 +1,79 @@
+// Features inspired by the "Ocarina of Time" remake (Switch 2), implemented on top of Ship of Harkinian.
+//
+//  - Manual jump button            (CVar: Remake.ManualJump / Remake.ManualJump.Btn)
+//  - Starting wallet of 200 rupees (CVar: Remake.Wallet200)
+//
+// Din's Fire in real time (Remake.RealTimeDinsFire), free diving (Remake.FreeDive) and the 3-digit
+// rupee counter live directly in z_player.c / z_parameter.c because they patch vanilla code paths.
+#include <libultraship/bridge/consolevariablebridge.h>
+
+#include "soh/Enhancements/game-interactor/GameInteractor.h"
+#include "soh/OTRGlobals.h"
+#include "soh/ShipInit.hpp"
+#include "soh/cvar_prefixes.h"
+
+extern "C" {
+#include "z64.h"
+#include "macros.h"
+#include "variables.h"
+extern PlayState* gPlayState;
+extern SaveContext gSaveContext;
+}
+
+#define CVAR_REMAKE_JUMP_NAME CVAR_ENHANCEMENT("Remake.ManualJump")
+#define CVAR_REMAKE_JUMP_BTN_NAME CVAR_ENHANCEMENT("Remake.ManualJump.Btn")
+#define CVAR_REMAKE_WALLET_NAME CVAR_ENHANCEMENT("Remake.Wallet200")
+
+static constexpr float kManualJumpVelocity = 7.0f;
+
+static constexpr uint32_t kJumpBlockedState1 =
+    PLAYER_STATE1_DEAD | PLAYER_STATE1_TALKING | PLAYER_STATE1_GETTING_ITEM | PLAYER_STATE1_CARRYING_ACTOR |
+    PLAYER_STATE1_HANGING_OFF_LEDGE | PLAYER_STATE1_CLIMBING_LEDGE | PLAYER_STATE1_CLIMBING_LADDER |
+    PLAYER_STATE1_FIRST_PERSON | PLAYER_STATE1_ON_HORSE | PLAYER_STATE1_IN_WATER | PLAYER_STATE1_IN_ITEM_CS |
+    PLAYER_STATE1_IN_CUTSCENE | PLAYER_STATE1_INPUT_DISABLED | PLAYER_STATE1_DAMAGED | PLAYER_STATE1_JUMPING |
+    PLAYER_STATE1_FREEFALL | PLAYER_STATE1_FLOOR_DISABLED | PLAYER_STATE1_HOOKSHOT_FALLING |
+    PLAYER_STATE1_SHIELDING | PLAYER_STATE1_CHARGING_SPIN_ATTACK;
+
+static constexpr uint32_t kJumpBlockedState2 =
+    PLAYER_STATE2_CRAWLING | PLAYER_STATE2_OCARINA_PLAYING | PLAYER_STATE2_UNDERWATER | PLAYER_STATE2_DIVING;
+
+static void OnPlayerUpdateManualJump() {
+    if (gPlayState == nullptr || gSaveContext.gameMode != GAMEMODE_NORMAL) {
+        return;
+    }
+
+    Player* player = GET_PLAYER(gPlayState);
+    if (player == nullptr) {
+        return;
+    }
+
+    // Don't jump while paused, in a text box, or changing screens
+    if (gPlayState->pauseCtx.state != 0 || gPlayState->msgCtx.msgMode != 0 || gPlayState->transitionMode != 0) {
+        return;
+    }
+
+    const uint32_t mask = CVarGetInteger(CVAR_REMAKE_JUMP_BTN_NAME, BTN_CUSTOM_MODIFIER2);
+    if (mask == 0 || !CHECK_BTN_ALL(gPlayState->state.input[0].press.button, mask)) {
+        return;
+    }
+
+    if (!(player->actor.bgCheckFlags & BGCHECKFLAG_GROUND) || (player->stateFlags1 & kJumpBlockedState1) ||
+        (player->stateFlags2 & kJumpBlockedState2) || (player->stateFlags3 & PLAYER_STATE3_MIDAIR)) {
+        return;
+    }
+
+    player->actor.velocity.y = kManualJumpVelocity;
+    player->actor.bgCheckFlags &= ~BGCHECKFLAG_GROUND;
+}
+
+static void RegisterManualJump() {
+    COND_HOOK(OnPlayerUpdate, CVarGetInteger(CVAR_REMAKE_JUMP_NAME, 0), OnPlayerUpdateManualJump);
+}
+
+static void RegisterWallet200() {
+    // Index 4 = wallets; level 0 is the starting wallet (vanilla: 99 rupees, remake: 200)
+    gUpgradeCapacities[UPG_WALLET][0] = CVarGetInteger(CVAR_REMAKE_WALLET_NAME, 0) ? 200 : 99;
+}
+
+static RegisterShipInitFunc manualJumpInit(RegisterManualJump, { CVAR_REMAKE_JUMP_NAME });
+static RegisterShipInitFunc wallet200Init(RegisterWallet200, { CVAR_REMAKE_WALLET_NAME });
