+    AddWidget(path, "Jump Button:", WIDGET_CVAR_BTN_SELECTOR)
+        .CVar(CVAR_ENHANCEMENT("Remake.ManualJump.Btn"))
+        .PreFunc([](WidgetInfo& info) { info.isHidden = !CVarGetInteger(CVAR_ENHANCEMENT("Remake.ManualJump"), 0); })
+        .Options(BtnSelectorOptions().DefaultValue(BTN_CUSTOM_MODIFIER2).Tooltip("Default is Modifier 2 (M2). Map it "
+                                                                                 "to a button in the Input Editor."));
+    AddWidget(path, "Classic Jump (automatic ledge jump)", WIDGET_CVAR_CHECKBOX)
+        .CVar(CVAR_ENHANCEMENT("Remake.ClassicJump"))
+        .Options(CheckboxOptions().DefaultValue(true).Tooltip(
+            "On: Link jumps automatically when running off a ledge, like the original game. Off: he just falls, "
+            "and you jump with the Manual Jump button, like in the remake."));
+    AddWidget(path, "Free Diving", WIDGET_CVAR_CHECKBOX)
+        .CVar(CVAR_ENHANCEMENT("Remake.FreeDive"))
+        .Options(CheckboxOptions().Tooltip("Link can dive to the maximum depth without needing the Zora Scales."));
+
+    AddWidget(path, "Combat and Items", WIDGET_SEPARATOR_TEXT);
+    AddWidget(path, "Real-Time Din's Fire", WIDGET_CVAR_CHECKBOX)
+        .CVar(CVAR_ENHANCEMENT("Remake.RealTimeDinsFire"))
+        .Options(CheckboxOptions().Tooltip("Din's Fire no longer freezes the world around Link while it is cast."));
+    AddWidget(path, "Starting Wallet of 200 Rupees", WIDGET_CVAR_CHECKBOX)
+        .CVar(CVAR_ENHANCEMENT("Remake.Wallet200"))
+        .Options(CheckboxOptions().Tooltip("The first wallet holds 200 rupees instead of 99."));
+
+    AddWidget(path, "Preset", WIDGET_SEPARATOR_TEXT);
+    AddWidget(path, "Enable All Remake Features", WIDGET_BUTTON)
+        .Options(ButtonOptions().Size(Sizes::Inline).Tooltip(
+            "Turns on the options above and the existing Ship options closest to the remake: Free Look camera, "
+            "faster ocarina playback, quick put away, hookshot target reticle, improved roll, D-Pad equips, "
+            "assignable tunics/boots, and a 150% speed modifier (Dash) held with Modifier 1."))
+        .Callback([](WidgetInfo& info) {
+            CVAR_INT_SHIP_INIT(CVAR_ENHANCEMENT("Remake.ManualJump"), 1);
+            CVAR_INT_SHIP_INIT(CVAR_ENHANCEMENT("Remake.FreeDive"), 1);
+            CVAR_INT_SHIP_INIT(CVAR_ENHANCEMENT("Remake.RealTimeDinsFire"), 1);
+            CVAR_INT_SHIP_INIT(CVAR_ENHANCEMENT("Remake.Wallet200"), 1);
+            CVAR_INT_SHIP_INIT(CVAR_SETTING("FreeLook.Enabled"), 1);
+            CVAR_INT_SHIP_INIT(CVAR_ENHANCEMENT("FastOcarinaPlayback"), 1);
+            CVAR_INT_SHIP_INIT(CVAR_ENHANCEMENT("QuickPutaway"), 1);
+            CVAR_INT_SHIP_INIT(CVAR_ENHANCEMENT("HookshotableReticle"), 1);
+            CVAR_INT_SHIP_INIT(CVAR_ENHANCEMENT("ImprovedRoll"), 1);
+            CVAR_INT_SHIP_INIT(CVAR_ENHANCEMENT("DpadEquips"), 1);
+            CVAR_INT_SHIP_INIT(CVAR_ENHANCEMENT("AssignableTunicsAndBoots"), 1);
+            CVAR_INT_SHIP_INIT(CVAR_ENHANCEMENT("SkipSwimDeepEndAnim"), 1);
+            CVarSetFloat(CVAR_CHEAT("SpeedModifier.Value"), 1.5f);
+            CVarSetInteger(CVAR_CHEAT("SpeedModifier.DoesntChangeJump"), 1);
+
+            Ship::Context::GetRawInstance()->GetWindow()->GetGui()->SaveConsoleVariablesNextFrame();
+        });
+
     // Skips & Speed-ups
     path.sidebarName = "Skips & Speed-ups";
     AddSidebarEntry("Enhancements", path.sidebarName, 3);
